# STAGING Supabase keys only — never production.
# Copy to .env.local (gitignored). See docs/environments.md
#
# Key name: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (sb_publishable_...).
# The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is still accepted as a fallback.

NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-staging-publishable-key
